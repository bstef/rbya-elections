# Copy to .env.local and fill in with values from your Supabase project
# (Supabase dashboard > Project Settings > API), or from the Supabase MCP
# `get_project_url` / `get_publishable_keys` tools.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only -- never expose to the browser, never
# prefix with NEXT_PUBLIC_. Used only by src/lib/supabase/admin.ts for
# out-of-band admin provisioning.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build magic-link / confirmation email redirect targets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key for transactional emails (nomination confirmations, pastor
# vetting requests, delegate registration/verification notices) -- see
# src/lib/email/send.ts. Get one at https://resend.com/api-keys after
# verifying both rbya.cloud (currently used as the "from" domain) and
# rbya.org (kept verified as a fallback/alternative) under Resend > Domains.
RESEND_API_KEY=
